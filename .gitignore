# --- Python ---
__pycache__/
*.py[cod]
*$py.class

# --- Virtual environments ---
.venv/
venv/
env/
ENV/

# --- Testing / coverage ---
.pytest_cache/
.coverage
.coverage.*
.coverage-contexts
.coverage-contexts.*
htmlcov/
coverage.xml
coverage.json
.mypy_cache/
.ruff_cache/

# --- Game data and generated output (the CONTENT is ignored) ---
# log/: game logs (local data). log_analisys/: the raw log split_turns.py reads.
# records/: the output of split_turns.py.
# The folders are kept via .gitkeep; everything else inside is ignored.
/log/*
!/log/.gitkeep
/log_analisys/*
!/log_analisys/.gitkeep
/records/*
!/records/.gitkeep

# --- Operating system files ---
.DS_Store
.DS_Store?
._*
Thumbs.db
desktop.ini

# --- Editors / IDE ---
.idea/
.vscode/
*.swp
*.swo
*~

# --- Temporary files ---
*.log
*.tmp

# --- Python packaging / build ---
build/
dist/
*.egg-info/
.eggs/
*.egg

# --- The submission package (output of utils/package_project.py) ---
/submission.tar.gz

# --- Hypothesis (local example database) ---
.hypothesis/

# --- Jupyter ---
.ipynb_checkpoints/
# Meta analysis notebooks (heavy, not versioned)
/notebook/

# --- Local backups ---
*.bak
# Ablation copies of main.py for local A/B experiments (heavy)
/_v_*.py
# Snapshots of main.py taken before a big change (main_pre_lana.py, ~1.2 MB)
/main_pre_*.py

# --- Environment / secrets ---
.env
.env.*
*.local

# --- Claude Code local settings (personal permission allowlist, not team config) ---
.claude/settings.local.json

# --- macOS extra ---
.AppleDouble
.LSOverride
.Spotlight-V100
.Trashes
.fseventsd

# --- NOT ignored (a maintenance note) ---
# The simulator's native libraries (cg/*.dll, cg/*.so, cg/*.dylib) and the
# reference data (deck.csv, dataset/EN_Card_Data.csv, tests/fixtures/*.json)
# ARE versioned: they are needed to run the agent and the tests.
# Do not add *.so/*.dll/*.dylib/*.csv patterns that would exclude them.
kaggle_token.txt
.kaggle/
dataset/Card_ID List_EN.pdf

# --- Competitor deck download ---
# The CSVs under competitor_decks/ ARE versioned (they are the corpus for the
# simulator). What is ignored is the download scaffolding: the resume cache
# and the raw replays (~4 MB each).
competitor_decks/.decks_cache.json
competitor_decks/.cache_replays/
competitor_decks_500/

# The 500-deck corpus is DERIVED data, not source: 137 lists plus four weight
# tables, all of them written by `utils/real_opponents.py` out of the raw
# replays above. The other corpora here (`deck/opponents/`,
# `deck/real_opponents/`) stay versioned because they are small and stable;
# this one is a snapshot of a leaderboard that moves, so a checkout that
# re-downloads gets a DIFFERENT meta and the numbers in
# docs/playbook-vs-meta-2026-08-13.md are not reproducible from it. The
# snapshot that produced them is described in docs/history/.
deck/real_opponents_500/

# --- Local engine workspace ---
# ptcg_engine/ is a local working copy, not part of the versioned project.
ptcg_engine/

# --- Local measurement engine (phase B) ---
# Built from ptcg_engine/ by cg/build_local_engine.sh. The PATCH is versioned;
# the source and the binary are not (competition-use-only, and it never ships).
cg/build/
